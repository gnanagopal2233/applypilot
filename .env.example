# ---- LLM (bring your own key) ----
# anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For ollama (or any OpenAI-compatible server)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Embeddings (optional; BM25 lexical retrieval is used when "none") ----
# none | openai | ollama
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Paths ----
PROFILE_DIR=./profile
DATA_DIR=./data

# ---- Worker ----
# cron in local time; default weekdays 9:05am
CRON=5 9 * * 1-5
# Max LLM scoring calls per run (cost guard)
MAX_LLM_SCORES_PER_RUN=60
# Optional: POST a JSON alert here on failures/summary (Slack/Discord webhook, ntfy.sh topic URL, ...)
NOTIFY_WEBHOOK=

# ---- Browser ----
HEADLESS=true
