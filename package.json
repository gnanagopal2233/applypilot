{
  "name": "applypilot",
  "version": "0.1.0",
  "description": "Open-source, multi-agent job application pilot: discovers jobs on public ATS boards, scores fit, tailors a grounded resume with RAG, verifies every claim, and auto-applies only when confidence is high.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "scout": "tsx src/cli.ts scout",
    "pipeline": "tsx src/cli.ts run",
    "worker": "tsx src/worker.ts",
    "mcp": "tsx src/mcp/server.ts",
    "eval": "tsx evals/run.ts",
    "smoke": "tsx evals/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "next build && next start -p 3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.2.0",
    "next": "^16.4.2",
    "node-cron": "^4.6.0",
    "openai": "^7.38.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.10"
  }
}
